
# Terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform crash logs
crash.log
crash.*.log

# Terraform CLI configuration
.terraformrc
terraform.rc

# Variable files (may contain secrets)
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive plan files
*.tfplan
*.plan

# Provider and dependency cache
.terraform.lock.hcl.backup

# Local environment files
.env
.env.*

# SSH keys and certificates
*.pem
*.key
*.p12
*.pfx

# Editor and IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
